#!/usr/bin/env -S uv run --script
# /// script
# requires-python = ">=3.11"
# dependencies = []
# ///
"""spinoff-plan — deterministic helper for the session-spinoff skill.

Verbs (all print JSON to stdout; refusals print to stderr and exit 2):

  args -- <raw skill arguments...>
      Validate the invocation flags and print the parsed form.
  snapshot --repo PATH
      Read Rex sessions, each tab's working directory and agent, the current
      agent, and the connected app clients. For each tab running an agent,
      read the tail of its transcript (found by PID through the sibling
      session-inventory) and count paths per repo. Assign each session a tier:
      1 = a tab started in the target repo or its worktrees, or its agent
      touched the repo at least HIT_THRESHOLD times recently.
      Read-only: it runs `rex ls`, `rex session inspect`, `rex block call
      ... process`, `rex client ls`, and `git rev-parse`, nothing else.
  verify-launch --session S --block B --expect-dir DIR --agent NAME
      Check that the new tab runs NAME with its working directory at DIR.
      Exit 0 when both hold, 3 when either does not (JSON says which).
  commands [--brief-file PATH]   (plan JSON on stdin)
      Build the worktree, launch, and jump commands. Pure: runs nothing.
      The brief is read from --brief-file when given, so free text never has
      to be escaped into JSON.
      This is what --dry-run prints.

Stdlib only.
"""

from __future__ import annotations

import argparse
import json
import os
import re
import shlex
import subprocess
import sys
from pathlib import Path

AGENTS = ("claude", "codex", "muse")
HIT_THRESHOLD = 3            # transcript path hits that count as "working in this repo"
TRANSCRIPT_TAIL = 300_000    # bytes read from the end of each live agent's transcript
VALUE_FLAGS = ("--session", "--name", "--repo")
BOOL_FLAGS = ("--new", "--dry-run") + tuple(f"--{a}" for a in AGENTS)


class SpinoffArgError(ValueError):
    """An invocation the skill must refuse before doing anything."""


# ── argument gate ────────────────────────────────────────────────────────


def parse_args(argv: list[str]) -> dict:
    out = {"idea": "", "placement": "ask", "session": None, "name": None,
           "repo": None, "agent": None, "dry_run": False}
    words: list[str] = []
    new = False
    agents: list[str] = []
    i = 0
    while i < len(argv):
        tok = argv[i]
        if tok == "--":  # everything after a bare -- is idea text
            words.extend(argv[i + 1:])
            break
        if tok in VALUE_FLAGS:
            if i + 1 >= len(argv) or argv[i + 1].startswith("--"):
                raise SpinoffArgError(f"{tok} needs a value")
            out[tok[2:]] = argv[i + 1]
            i += 2
            continue
        if tok == "--new":
            new = True
        elif tok == "--dry-run":
            out["dry_run"] = True
        elif tok in tuple(f"--{a}" for a in AGENTS):
            agents.append(tok[2:])
        elif tok.startswith("--") and words:
            words.append(tok)  # idea text has started: "add a --version flag"
        elif tok.startswith("--"):
            raise SpinoffArgError(f"unknown flag {tok}; supported: "
                                  + " ".join(VALUE_FLAGS + BOOL_FLAGS))
        else:
            words.append(tok)
        i += 1

    if len(agents) > 1:
        raise SpinoffArgError("pass at most one agent flag (--claude, --codex, --muse)")
    if new and out["session"]:
        raise SpinoffArgError("--new and --session conflict: choose a new session or an existing one")
    if out["name"] and out["session"]:
        raise SpinoffArgError("--name names a new session and cannot be used with --session")

    out["agent"] = agents[0] if agents else None
    out["idea"] = " ".join(words)
    if out["session"]:
        out["placement"] = "session"
    elif new or out["name"]:
        out["placement"] = "new"
    return out


# ── small pure helpers ───────────────────────────────────────────────────


def slugify(text: str, max_len: int = 40) -> str:
    slug = re.sub(r"[^a-z0-9]+", "-", text.lower()).strip("-")
    return slug[:max_len].rstrip("-")


def detect_agent(process: dict) -> str | None:
    argv0 = (process.get("foreground") or {}).get("argv0") or ""
    name = os.path.basename(argv0.lstrip("-"))
    return name if name in AGENTS else None


def repo_hits(text: str, home: str, root_of) -> dict:
    """Count absolute paths under home in text, grouped by the repo they belong to.

    root_of(path) returns a repo's git common dir, or None for non-repo paths,
    so every worktree of a repo counts toward the same repo.
    """
    hits: dict = {}
    for path in re.findall(re.escape(home.rstrip("/")) + r"/[A-Za-z0-9._/\-]+", text):
        common = root_of(path)
        if common:
            hits[common] = hits.get(common, 0) + 1
    return hits


def label_names_repo(label: str, repo_name: str) -> bool:
    """True when the repo name's words appear, in order and adjacent, in the label."""
    words = [w for w in re.split(r"[^a-z0-9]+", label.lower()) if w]
    want = [w for w in re.split(r"[^a-z0-9]+", repo_name.lower()) if w]
    if not want:
        return False
    return any(words[i:i + len(want)] == want for i in range(len(words) - len(want) + 1))


def _repo_name(common_dir: str) -> str:
    path = Path(common_dir)
    return path.parent.name if path.name == ".git" else path.name.removesuffix(".git")


def classify_sessions(sessions: list[dict], target_common_dir: str) -> list[dict]:
    """Assign each Rex session a tier from facts; order only by facts.

    Tier 1: a tab started in the target repo or one of its worktrees, or the
    agent in a tab touched the repo at least HIT_THRESHOLD times in its recent
    transcript. Tier 2: everything else. Within tier 1, tabs started in the
    repo come first, then more transcript hits; tier 2 keeps Rex's order. A
    label naming the repo is reported as a fact but never sets the tier.
    Ordering by what a label *means* is left to the model running the skill,
    which may reorder only within a tier.
    """
    repo_name = _repo_name(target_common_dir)
    out = []
    for index, s in enumerate(sessions):
        tabs = [tab for w in s.get("windows", []) for tab in w.get("tabs", [])]
        repo_tabs = sum(1 for w in s.get("windows", [])  # a Rex tab is a window; count it once
                        if any(tab.get("repo_dir") == target_common_dir for tab in w.get("tabs", [])))
        hits = sum((tab.get("touched") or {}).get(target_common_dir, 0) for tab in tabs)
        agents = sorted({tab["agent"] for tab in tabs if tab.get("agent")})
        dirs = list(dict.fromkeys(tab["cwd"] for tab in tabs if tab.get("cwd")))
        names_repo = label_names_repo(s.get("label", ""), repo_name)
        facts = []
        if repo_tabs:
            facts.append(f"{repo_tabs} tab{'s' if repo_tabs != 1 else ''} in this repo")
        if hits:
            facts.append(f"agent touched this repo {hits}× recently")
        if names_repo:
            facts.append("label names this repo")
        if agents:
            facts.append("running " + ", ".join(agents))
        tier = 1 if repo_tabs or hits >= HIT_THRESHOLD else 2
        out.append({**s, "tier": tier, "repo_tabs": repo_tabs, "repo_hits": hits,
                    "label_names_repo": names_repo, "agents": agents, "dirs": dirs,
                    "facts": facts, "_index": index})
    out.sort(key=lambda s: (s["tier"], -s["repo_tabs"], -s["repo_hits"] if s["tier"] == 1 else 0,
                            s["_index"]))
    for s in out:
        del s["_index"]
    return out


def check_launch(process: dict, expect_dir: str, agent: str) -> dict:
    """Did the new tab start the expected agent in the expected directory?"""
    cwd = (process.get("foreground") or {}).get("cwd")
    cwd_ok = bool(cwd) and os.path.realpath(cwd) == os.path.realpath(expect_dir)
    running = detect_agent(process)
    agent_ok = running == agent
    return {"ok": cwd_ok and agent_ok, "cwd": cwd, "agent": running,
            "cwd_ok": cwd_ok, "agent_ok": agent_ok}


def jump_command(client: str | None, session_id: str, window_id: str | None) -> list[str]:
    cmd = ["rex"]
    if client:
        cmd += ["-C", client]
    cmd += ["do", "session.select", f"session_id={session_id}"]
    if window_id:
        cmd.append(f"window_id={window_id}")
    return cmd


REQUIRED_KEYS = ("repo", "default_branch", "branch", "worktree", "placement",
                 "tab_label", "agent", "brief")


def build_commands(plan: dict) -> dict:
    missing = [k for k in REQUIRED_KEYS if not plan.get(k)]
    if plan.get("placement") == "new" and not plan.get("name"):
        missing.append("name")
    if plan.get("placement") == "session" and not plan.get("session"):
        missing.append("session")
    if missing:
        raise SpinoffArgError("plan is missing " + ", ".join(missing))
    if plan["placement"] not in ("new", "session"):
        raise SpinoffArgError("placement must be 'new' or 'session'")

    repo = str(Path(plan["repo"]).resolve())
    wt = os.path.normpath(os.path.join(repo, plan["worktree"]))  # relative → against the repo
    base = plan["default_branch"].removeprefix("origin/")
    launch_dir = os.path.normpath(os.path.join(wt, plan.get("launch_dir") or "."))
    inside = launch_dir == wt or launch_dir.startswith(wt + os.sep)
    parent = wt.startswith(launch_dir.rstrip(os.sep) + os.sep)
    if not (inside or parent):
        raise SpinoffArgError(f"launch_dir {launch_dir} must be the worktree, inside it, "
                              f"or a parent of it ({wt})")
    agent_argv = [plan["agent"], plan["brief"]]
    if plan["placement"] == "new":
        launch = ["rex", "new", plan["name"], "--window", plan["tab_label"],
                  "-c", launch_dir, "--json", "--", *agent_argv]
    else:
        launch = ["rex", "window", "new", "-s", plan["session"], plan["tab_label"],
                  "-c", launch_dir, "--focus=false", "--json", "--", *agent_argv]
    cmds = {
        "worktree": ["git", "-C", repo, "fetch", "origin"],
        "worktree_add": ["git", "-C", repo, "worktree", "add", "-b", plan["branch"], wt,
                         f"origin/{base}"],
        "launch": launch,
        "launch_dir": launch_dir,
        "jump_template": jump_command(plan.get("client"), "<session_id>", "<window_id>"),
    }
    cmds["shell"] = {k: shlex.join(v) for k, v in cmds.items() if isinstance(v, list)}
    return cmds


# ── read-only snapshot ───────────────────────────────────────────────────


def _run_json(argv: list[str]) -> dict | None:
    try:
        proc = subprocess.run(argv, capture_output=True, text=True, timeout=15)
    except (OSError, subprocess.TimeoutExpired):
        return None
    if proc.returncode != 0:
        return None
    try:
        return json.loads(proc.stdout)
    except json.JSONDecodeError:
        return None


def git_common_dir(path: str) -> str | None:
    try:
        proc = subprocess.run(["git", "-C", path, "rev-parse", "--path-format=absolute",
                               "--git-common-dir"], capture_output=True, text=True, timeout=10)
    except (OSError, subprocess.TimeoutExpired):
        return None
    return str(Path(proc.stdout.strip()).resolve()) if proc.returncode == 0 else None


class _RepoRoots:
    """Map a path to its repo's git common dir, caching every lookup."""

    def __init__(self):
        self.by_root: dict = {}
        self.by_dir: dict = {}

    def __call__(self, path: str) -> str | None:
        d = path if os.path.isdir(path) else os.path.dirname(path)
        seen = []
        while d and d != os.path.dirname(d):
            if d in self.by_dir:
                found = self.by_dir[d]
                break
            seen.append(d)
            if os.path.exists(os.path.join(d, ".git")):
                if d not in self.by_root:
                    self.by_root[d] = git_common_dir(d)
                found = self.by_root[d]
                break
            d = os.path.dirname(d)
        else:
            found = None
        for s in seen:
            self.by_dir[s] = found
        return found


def _live_transcripts() -> tuple[dict, str]:
    """PID → transcript path for running agents, via the sibling session-inventory."""
    inv = Path(__file__).resolve().parent.parent.parent / "session-agent-list" / "scripts" / "session-inventory"
    if not inv.exists():
        return {}, f"unavailable: {inv} not found"
    data = _run_json([sys.executable, str(inv), "list", "--live", "--json"])
    if data is None:
        return {}, "unavailable: session-inventory failed"
    rows = data if isinstance(data, list) else data.get("sessions", [])
    return {r["pid"]: r["transcript"] for r in rows if r.get("pid") and r.get("transcript")}, "ok"


def _touched(transcript: str, roots: _RepoRoots) -> dict:
    try:
        with open(transcript, "rb") as f:
            f.seek(0, os.SEEK_END)
            f.seek(max(0, f.tell() - TRANSCRIPT_TAIL))
            text = f.read().decode("utf-8", "ignore")
    except OSError:
        return {}
    hits = repo_hits(text, os.path.expanduser("~"), roots)
    return dict(sorted(hits.items(), key=lambda kv: -kv[1])[:5])


def _blocks(window: dict):
    for layer in window.get("layers", []):
        yield from layer.get("blocks", [])


def snapshot(repo: str) -> dict:
    target = git_common_dir(repo)
    if target is None:
        raise SpinoffArgError(f"{repo} is not inside a git repository")
    listing = _run_json(["rex", "ls", "--json"])
    if listing is None:
        raise SpinoffArgError("rex ls failed; check the connection with `rex whoami --json`")
    transcripts, evidence = _live_transcripts()
    roots = _RepoRoots()
    sessions = []
    for s in listing.get("sessions", []):
        sid = s["session_id"]
        detail = _run_json(["rex", "session", "inspect", sid, "--json"]) or {}
        windows = []
        for w in detail.get("windows", []):
            tabs = []
            for b in _blocks(w):
                proc = _run_json(["rex", "block", "call", "-s", sid, "-b", b["block_id"], "process"]) or {}
                fg = proc.get("foreground") or {}
                cwd = fg.get("cwd")
                transcript = transcripts.get(fg.get("pid"))
                tabs.append({"block_id": b["block_id"], "cwd": cwd,
                             "repo_dir": git_common_dir(cwd) if cwd else None,
                             "agent": detect_agent(proc),
                             "touched": _touched(transcript, roots) if transcript else {}})
            windows.append({"window_id": w["window_id"], "label": w.get("label"), "tabs": tabs})
        sessions.append({"session_id": sid, "label": s.get("label", ""), "windows": windows})

    current_agent = None
    if os.environ.get("REX_SESSION") and os.environ.get("REX_BLOCK"):
        proc = _run_json(["rex", "block", "call", "-s", os.environ["REX_SESSION"],
                          "-b", os.environ["REX_BLOCK"], "process"])
        current_agent = detect_agent(proc or {})

    clients = (_run_json(["rex", "client", "ls", "--json"]) or {}).get("clients", [])
    apps = [c["client_id"] for c in clients if (c.get("info") or {}).get("kind") == "app"]

    return {
        "target_common_dir": target,
        "transcript_evidence": evidence,
        "current_agent": current_agent,
        "app_clients": apps,
        "labels_in_use": [s["label"] for s in sessions],
        "sessions": classify_sessions(sessions, target),
    }


# ── CLI ──────────────────────────────────────────────────────────────────


def main(argv: list[str] | None = None) -> int:
    p = argparse.ArgumentParser(prog="spinoff-plan", description=__doc__,
                                formatter_class=argparse.RawDescriptionHelpFormatter)
    sub = p.add_subparsers(dest="verb", required=True)
    a = sub.add_parser("args")
    a.add_argument("raw", nargs=argparse.REMAINDER)
    s = sub.add_parser("snapshot")
    s.add_argument("--repo", required=True)
    v = sub.add_parser("verify-launch")
    v.add_argument("--session", required=True)
    v.add_argument("--block", required=True)
    v.add_argument("--expect-dir", required=True)
    v.add_argument("--agent", required=True, choices=AGENTS)
    c = sub.add_parser("commands")
    c.add_argument("--brief-file", help="read the brief from this file instead of the plan's 'brief'")
    ns = p.parse_args(argv)
    try:
        if ns.verb == "args":
            raw = ns.raw[1:] if ns.raw[:1] == ["--"] else ns.raw
            result = parse_args(raw)
        elif ns.verb == "verify-launch":
            proc = _run_json(["rex", "block", "call", "-s", ns.session, "-b", ns.block, "process"])
            if proc is None:
                raise SpinoffArgError(f"could not read block {ns.block} in {ns.session}")
            result = check_launch(proc, ns.expect_dir, ns.agent)
            json.dump(result, sys.stdout, indent=2)
            print()
            return 0 if result["ok"] else 3
        elif ns.verb == "snapshot":
            result = snapshot(ns.repo)
        else:
            try:
                plan = json.load(sys.stdin)
            except json.JSONDecodeError as exc:
                raise SpinoffArgError(f"plan on stdin is not valid JSON: {exc}") from None
            if ns.brief_file:
                plan["brief"] = Path(ns.brief_file).read_text()
            result = build_commands(plan)
    except SpinoffArgError as exc:
        print(f"spinoff-plan: {exc}", file=sys.stderr)
        return 2
    json.dump(result, sys.stdout, indent=2)
    print()
    return 0


if __name__ == "__main__":
    sys.exit(main())
